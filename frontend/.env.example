# Copy to .env.local (gitignored) and adjust for your environment.
# Falls back to http://localhost:8000 if unset — see src/api.ts.
VITE_API_BASE=http://localhost:8000

# OAuth 2.0 Web Client ID from Google Cloud Console (APIs & Services ->
# Credentials -> Create Credentials -> OAuth client ID -> Web application).
# Leave blank to simply not show the Google Sign-In button anywhere — see
# src/components/GoogleSignInButton.tsx, which renders nothing if unset.
VITE_GOOGLE_CLIENT_ID=
