# Copy to .env.production and fill in before `npm run build` — see
# README.md's "Deploying to OVH" section, step "Deploy the frontend".
# Baked into the static build at build time (Vite env vars are not
# read at runtime), so a wrong value here means rebuilding, not just
# restarting anything.

# Public HTTPS URL of the deployed backend (the same domain you'll set
# WATI/Razorpay webhooks against) — never http://localhost in production.
VITE_API_BASE=https://
