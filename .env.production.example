# Production/staging environment template for the OVH deployment — copy to
# .env.production and fill in real values. See README.md's "Deploying to
# OVH" section for the full walkthrough. Run
# scripts/release_preflight.py --env-file .env.production before every
# deploy; it fails fast on the mistakes below rather than 500ing in prod.

# --- Core ---
ENVIRONMENT=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be 32+ characters and NOT "changeme" — config.py refuses to boot
# outside development otherwise.
SECRET_KEY=

# --- Database ---
# Two supported options:
# 1. Self-hosted (docker-compose.ovh.yml's postgres service) — fill in
#    POSTGRES_USER/PASSWORD/DB below (read by the official postgres Docker
#    image to initialize the database) and point DATABASE_URL at the
#    service's private/internal hostname (e.g. "postgres", not
#    localhost/127.0.0.1), using the SAME password as POSTGRES_PASSWORD.
# 2. Managed (e.g. Neon) — leave POSTGRES_USER/PASSWORD/DB blank (unused,
#    since there's no local postgres container to initialize) and set
#    DATABASE_URL to the connection string from your provider's dashboard
#    (Neon's requires ?sslmode=require). Apply database/schema.sql to it
#    directly with psql before first deploy — nothing else in this repo
#    provisions a managed database's schema automatically.
POSTGRES_USER=qlass
POSTGRES_PASSWORD=CHANGE_ME_SAME_PASSWORD_AS_DATABASE_URL_BELOW
POSTGRES_DB=qlass_ai
DATABASE_URL=postgresql://qlass:CHANGE_ME_SAME_PASSWORD_AS_DATABASE_URL_BELOW@postgres:5432/qlass_ai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# --- Redis / Celery ---
# Use the private/internal hostname of the redis service (e.g. "redis").
REDIS_URL=redis://redis:6379/0

# --- LLM Providers ---
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- WhatsApp (Wati) ---
WHATSAPP_TOKEN=
WATI_API_ENDPOINT=
# The WhatsApp Business number this Wati account sends from (e.g.
# 91XXXXXXXXXX) — required by the v2 sendTemplateMessages API; omitting it
# doesn't error, it silently degrades every template send instead (see
# app/services/whatsapp_client.py's send_broadcast_template docstring).
WATI_CHANNEL_NUMBER=
# Generated by Wati when you register this deployment's real HTTPS webhook
# URL in the Wati dashboard — leave blank until after DNS/TLS are live.
WATI_WEBHOOK_SECRET=

# --- Google Drive Sync ---
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Vector DB ---
CHROMA_PERSIST_DIR=./rag/chroma_store

# --- Sarvam (Indic speech-to-text / text-to-speech) ---
SARVAM_API_KEY=
SARVAM_LANGUAGE_CODE=en-IN
SARVAM_TTS_SPEAKER=priya

# --- Azure AI Vision (OCR for image-based homework/question photos) ---
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# --- Azure OpenAI (gpt-image series image generation) ---
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_KEY=
AZURE_IMAGE_DEPLOYMENT=
AZURE_IMAGE_API_VERSION=2025-04-01-preview

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=

# --- Razorpay (real payments in production — use LIVE keys, not test keys) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_STUDENT_PLAN_ID=
RAZORPAY_TEACHER_PLAN_ID=
# Generated by Razorpay when you register this deployment's real HTTPS
# webhook URL (https://<your-domain>/webhook/razorpay/subscriptions) in the
# Razorpay dashboard — leave blank until after DNS/TLS are live.
RAZORPAY_WEBHOOK_SECRET=

# --- Portal ---
# Public HTTPS URL of the deployed frontend — never http://localhost in production.
PORTAL_BASE_URL=https://
# Comma-separated browser origins allowed to call the API. Set to your
# exact HTTPS portal domain(s) — never a wildcard (*) in production.
ALLOWED_ORIGINS=

# --- Gamma (teacher-facing AI presentation generation) ---
GAMMA_API_KEY=

# --- Voyage AI (text embeddings for semantic textbook retrieval) ---
# Free tier at https://voyageai.com. Blank until set — the tutor falls
# back to Postgres full-text search alone (see app.services.retrieval).
# Requires the pgvector extension + document_chunks.embedding column —
# see database/migrations/0041_add_document_chunk_embeddings.sql.
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3.5-lite
VOYAGE_EMBEDDING_DIMENSIONS=1024

# --- Firebase Cloud Messaging (push notifications to the Android app) ---
# Path to a service account JSON from Firebase console > Project settings >
# Service accounts > Generate new private key. Optional — push just stays
# inert (no crash) until this is set. See README.md's "Android App" section.
FIREBASE_CREDENTIALS_PATH=
