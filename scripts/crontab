# Versioned crontab fragment for the Skoolgpt backend host.
# Install with:  crontab scripts/crontab   (server timezone assumed to be IST)
MAILTO=""
APP=/usr/share/nginx/aitutor.qlass.in/public_python_aios
PY=/usr/share/nginx/aitutor.qlass.in/public_python_aios/venv/bin/python

# Nightly DB backup — 02:30 IST
30 2 * * *   cd $APP && bash scripts/backup_db.sh >> logs/cron-backup.log 2>&1

# Subscription expiry reminders — daily 08:00 IST
0 8 * * *    cd $APP && $PY scripts/send_subscription_expiry_reminders.py >> logs/cron-subscription-expiry.log 2>&1

# Re-engagement nudges — daily 11:00 IST
0 11 * * *   cd $APP && $PY scripts/send_reengagement_nudges.py >> logs/cron-reengagement.log 2>&1

# Engagement nudges — daily 18:00 IST (feature_highlight/social_proof only
# — "fun_fact" is submitted/fetched by the two batch jobs below instead)
0 18 * * *   cd $APP && $PY scripts/send_engagement_nudges.py >> logs/cron-engagement.log 2>&1

# Fun-fact nudge batch — submit daily 16:00 IST (Anthropic Message Batches
# API, ~50% cheaper than a synchronous call; see app.services.nudges)
0 16 * * *   cd $APP && $PY scripts/submit_nudge_funfact_batch.py >> logs/cron-nudge-funfact-submit.log 2>&1

# Fun-fact nudge batch — fetch + send 17:15 IST (~75min after submit; most
# batches finish well under an hour, SLA up to 24h) and again 22:00 IST as
# a cheap retry for anything not yet ready
15 17 * * *  cd $APP && $PY scripts/fetch_nudge_funfact_batch.py >> logs/cron-nudge-funfact-fetch.log 2>&1
0 22 * * *   cd $APP && $PY scripts/fetch_nudge_funfact_batch.py >> logs/cron-nudge-funfact-fetch-retry.log 2>&1

# Spaced-repetition revision reminders — daily 12:30 IST
30 12 * * *  cd $APP && $PY scripts/send_revision_reminders.py >> logs/cron-revision.log 2>&1

# Habit nudges — daily 19:00 IST
0 19 * * *   cd $APP && $PY scripts/send_habit_nudges.py >> logs/cron-habit.log 2>&1

# Parent digests — Sunday 09:00 IST
0 9 * * 0    cd $APP && $PY scripts/send_parent_digests.py >> logs/cron-parent-digests.log 2>&1

# Referral nudges — Sunday 10:00 IST
0 10 * * 0   cd $APP && $PY scripts/send_referral_nudges.py >> logs/cron-referral.log 2>&1
