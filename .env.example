# --- Core ---
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (32+ chars) for staging and production.
SECRET_KEY=changeme

# --- Database ---
DATABASE_URL=postgresql://qlass:qlass@localhost:5433/qlass_ai

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- LLM Providers ---
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- WhatsApp (Wati) ---
WHATSAPP_TOKEN=
WATI_API_ENDPOINT=
WATI_WEBHOOK_SECRET=

# --- Google Drive Sync ---
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Vector DB ---
CHROMA_PERSIST_DIR=./rag/chroma_store

# --- Sarvam (Indic speech-to-text / text-to-speech) ---
SARVAM_API_KEY=
SARVAM_LANGUAGE_CODE=en-IN
SARVAM_TTS_SPEAKER=priya

# --- Azure AI Vision (OCR for image-based homework/question photos) ---
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# --- Azure OpenAI (gpt-image series image generation — DALL-E 3 retired March 2026) ---
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_KEY=
AZURE_IMAGE_DEPLOYMENT=
AZURE_IMAGE_API_VERSION=2025-04-01-preview

# --- YouTube Data API v3 (best-matching video suggestion for a topic) ---
YOUTUBE_API_KEY=

# --- Razorpay (parent/student self-serve credit top-ups) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_STUDENT_PLAN_ID=
RAZORPAY_TEACHER_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# --- Portal (used server-side to build /pay links to text parents) ---
PORTAL_BASE_URL=http://localhost:5173
# Comma-separated browser origins allowed to call the API. Set to your
# HTTPS portal domain(s) in production; never use * in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# --- Gamma (teacher-facing AI presentation generation) ---
GAMMA_API_KEY=

# --- Firebase Cloud Messaging (push notifications to the Android app) ---
# Optional — see README.md's "Android App" section. Leave blank locally;
# push just stays inert with no crash.
FIREBASE_CREDENTIALS_PATH=
